# Copy to a private env file outside git if you need overrides.
# Do not commit secrets. This repository ships no .env.

DATABASE_URL=sqlite:///./edunexus.db
# PostgreSQL example (docker-compose):
# DATABASE_URL=postgresql+psycopg://edunexus:edunexus@postgres:5432/edunexus

JWT_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=14

# Leave unset to use the in-memory document store.
MONGO_URL=
MONGO_DB=edunexus

# 1 runs task functions in-process. Set 0 when a Redis broker is available.
CELERY_TASK_ALWAYS_EAGER=1
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

MOCK_GATEWAY_SECRET=change-me-mock-gateway
# Razorpay is never charged by this build. Empty keys raise NotConfigured.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

RATE_LIMIT_PER_MINUTE=60
SEED_ON_STARTUP=1
